# Optional settings; export these in the shell, or use Streamlit secrets.
# This file is documentation. The app does not automatically load .env files.
QWEN_CACHE_DIR=/path/to/model/cache
OLLAMA_HOST=http://localhost:11434
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-id
LLM_API_KEY=
HOSTED_ONLY=false
ARTIFICIAL_ANALYSIS_API_KEY=
AA_API_KEY=
# Optional: default snapshot; otherwise uses snapshots/aa_latest.json in the working directory.
# AA_SNAPSHOT_PATH=/path/to/aa_snapshot.json
